name: ht-music
arch: amd64
platform: linux
version: "@VERSION@"
section: sound
priority: optional
maintainer: nekolab
vendor: nekolab
homepage: https://htm.nekolab.app
license: GPL-3.0
description: Native YouTube Music client

contents:
  - src: "@PAYLOAD@"
    dst: /opt/ht-music
    type: tree
  - src: /opt/ht-music/bin/ht-music
    dst: /usr/bin/ht-music
    type: symlink
  - src: "@PAYLOAD@/share/applications/ht-music.desktop"
    dst: /usr/share/applications/ht-music.desktop
  - src: "@PAYLOAD@/share/icons/hicolor/scalable/apps/ht-music.svg"
    dst: /usr/share/icons/hicolor/scalable/apps/ht-music.svg

deb:
  compression: zstd

rpm:
  compression: zstd

overrides:
  deb:
    depends: @DEB_DEPENDS@
  rpm:
    depends: @RPM_DEPENDS@
